# HTTP Server
APP_HOST=0.0.0.0
APP_PORT=8080
MAX_CONCURRENT_REQUESTS=128
HTTP_MAX_REQ_TIME_SECONDS=10

# Safe model dictionary (JSON + SHA-256)
MODEL_PATH=data/sentiment_v1.json
MODEL_SHA256_PATH=data/sentiment_v1.json.sha256
MODEL_LOAD_TIMEOUT_MS=10000
INFERENCE_TIMEOUT_MS=500

# Outbound Quality Assurance integration (durable file-backed outbox when QA_SERVICE_URL is set)
QA_SERVICE_URL=
OUTBOX_LOG_PATH=logs/qa_outbox.jsonl
SLA_LIMIT_SECONDS=900
QA_MAX_RETRIES=3
QA_RETRY_DELAY_MS=100
QA_BACKGROUND_INTERVAL_SECONDS=30
QA_HTTP_TIMEOUT_SECONDS=5

# Logging
LOG_LEVEL=INFO
