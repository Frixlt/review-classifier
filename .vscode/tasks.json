{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make: check (full gate)",
      "type": "shell",
      "command": "make check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "make: format (Spotless)",
      "type": "shell",
      "command": "make format",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "make: lint (Checkstyle + PMD + SpotBugs)",
      "type": "shell",
      "command": "make lint",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "make: test (JUnit 5)",
      "type": "shell",
      "command": "make test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "make: coverage (JaCoCo >= 80%)",
      "type": "shell",
      "command": "make coverage",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "make: run HTTP server (:8080)",
      "type": "shell",
      "command": "make run PORT=8080",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "make: smoke curl (:8080)",
      "type": "shell",
      "command": "make smoke PORT=8080",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
